{
  "name": "boycott-agent-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boycott Agent REST API — the n8n pipeline as a plain Node.js server.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "new-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "eval": "node eval/run.js",
    "eval:snapshot": "node eval/snapshot.js",
    "eval:brands": "node eval/run-brands.js",
    "eval:brands:snapshot": "node eval/brand-snapshot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.13.1"
  }
}
