# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (any values; Docker creates it on first start) ---
POSTGRES_USER=boycott
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=boycott

# --- Tavily (web search + page extraction) — free key at https://tavily.com ---
TAVILY_API_KEY=
# "basic" = 1 credit, "advanced" = 2. Measured: basic extraction loses nothing, basic search misses boycotts.
TAVILY_SEARCH_DEPTH=advanced
TAVILY_EXTRACT_DEPTH=basic

# --- Global budget: shared by ALL website keys, stored in the database ---
# Free Tavily plan = 1000 credits/month. 30/day x 31 days stays under it.
TAVILY_DAILY_CREDITS=30
TAVILY_MONTHLY_CREDITS=950
LLM_DAILY_CALLS=400

# --- LLM: any OpenAI-compatible endpoint. Free Gemini key at https://aistudio.google.com/apikey ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Tried left to right when the model above is busy. List what your key offers:
#   GET {LLM_BASE_URL}/models
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
LLM_MAX_CONCURRENCY=2

# --- Who may call the API ---
# One name:key pair per website, comma-separated. Keys must be 24+ characters.
# Generate one with:  cd server && npm run new-key
API_KEYS=my-website:paste-a-generated-key-here
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300

# --- Production only (docker-compose.prod.yml) ---
# Public hostname of this API; HTTPS certificates are obtained automatically for it.
DOMAIN=api.example.com
